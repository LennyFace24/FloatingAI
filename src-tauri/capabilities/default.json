{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the floating, chat, and settings windows",
  "windows": [
    "floating",
    "chat",
    "settings"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-outer-position",
    "core:window:allow-set-position",
    "opener:default",
    "store:default"
  ]
}
