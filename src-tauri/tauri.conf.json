{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Floating AI",
  "version": "0.2.0",
  "identifier": "com.floatingai.app",
  "build": {
    "devUrl": "http://localhost:1520",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "floating",
        "title": "Floating AI",
        "width": 50,
        "height": 50,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "backgroundColor": [0, 0, 0, 0],
        "resizable": false,
        "skipTaskbar": true,
        "url": "index.html"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDZENjhEQ0U4RUFDMkY0QjAKUldTdzlNTHE2TnhvYmVSbzljaVFyS1dHNkhQWDYvWFN5V3daeVU0NXpCdUFUb1FueVRRME9YQXgK",
      "endpoints": [
        "https://github.com/LennyFace24/FloatingAI/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
